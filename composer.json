{
	"name": "gutenbergkits/releaso",
	"description": "Beautiful, filterable changelogs for WordPress plugins.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Releaso\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Releaso\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
